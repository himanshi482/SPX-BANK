[Unit]
Description=SPX Banking Flask application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spxapp
Group=spxapp
WorkingDirectory=/srv/spx-app/current
EnvironmentFile=/etc/spx-banking.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/spx-app/venv/bin/gunicorn --workers 2 --bind 0.0.0.0:5000 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
