# Copy this file to /etc/spx-banking.env on the application EC2 instance.
# Do not commit the real file: it contains production credentials.
SMTP_SERVER=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=replace-with-mailbox@example.com
SMTP_PASS=replace-with-mailbox-password

DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=spxapp
DB_PASS=replace-with-rds-app-password
DB_NAME=spxbank
DB_SSL_CA=/etc/ssl/certs/rds-global-bundle.pem
DB_SSL_VERIFY_CERT=true
DB_SSL_VERIFY_IDENTITY=true

SECRET_KEY=replace-with-a-long-random-value
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Bank Administrator
